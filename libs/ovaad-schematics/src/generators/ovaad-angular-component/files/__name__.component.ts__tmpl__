/*

<%= className %>

PURPOSE :

VIEWS :

ELEMENTS :

INTERACTIVITY :

GETS DATA FROM :

SENDS DATA TO :

USER STORIES :

*/





import { Component<% if( componentType !== "standard" ){%><%-`, Input`%><%}%> }    from '@angular/core';
import { CommonModule } from '@angular/common';
<% if( importList.length > 0 ) { %><% for( let i = 0; i < importList.length; i++) {%>
<%- importList[i] %><% } %><% } %>





@Component({
    selector    : 'lib-<%= fileName %>',
    imports     : [
        CommonModule,<% if( metaDataImports.length > 0 ) { %><% for( let i = 0; i < metaDataImports.length; i++) {%>
        <%-metaDataImports[i]+','%><% } %><% } %>
    ],
    templateUrl : './<%= fileName %>.component.html',
    styleUrls   : [ './<%= fileName %>.component.css' ]
})

export class <%= className %>Component {

    <% if( propList.length > 0 ) { %>
    @Input() Label! : string;<% for( let i = 0; i < propList.length; i++) {%>
    <%- propList[i] %><% } %><% } %>
}