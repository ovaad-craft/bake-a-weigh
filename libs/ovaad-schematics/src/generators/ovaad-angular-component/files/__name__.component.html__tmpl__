<section class="mainContainer"
    <% if(controlType === 'FormGroup' || controlType === 'FormArrayGroup') { %>
        <%-`[formGroup]="Control"`%>
    <% } %> >




<% if(componentType === 'standard'){%>
    <p><%-`${fileName} ready for awesomeness!!!`%></p>
<%}%>





<% if(componentType === 'custom form control'){%>




    <% if(controlType === 'FormControl'){%>
    
    <label>
    
        <h6>{{Label}}</h6>

        <input [(ngModel)]="Control.value" />
    
    </label>    
    
    <%}%>





    <% if(controlType === 'FormGroup'){%>
    
    <p>{{ Control.value | json }}</p>
    
    <%}%>





    <% if(controlType === 'FormArrayGroup'){%>
    
        <article class="listContainer" [formArrayName]="'<%-`${listPropertyName}`%>'">

            @for(a of Control.controls.<%-`${listPropertyName}`%>.controls; track $index){
                
                    <article>


                        <p>{{ a.value | json }}</p>

                        <button (click)="removeControl($index)">delete item</button>


                    </article>
            }

        </article>

        <button (click)="addControl()">add item</button>
    
    <%}%>




<%}%>





</section>